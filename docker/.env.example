# Copy this file to .env and replace both values with private random secrets.
# HUIYE_ADMIN_PASSWORD must be at least 12 characters; used only when creating
# the first admin account. Change later from the web admin panel.
HUIYE_ADMIN_PASSWORD=replace-with-a-private-password-at-least-12-chars

# NapCat must use the same token when connecting to /internal/onebot/ws.
# Use at least 16 characters; a random 32+ character value is recommended.
HUIYE_NAPCAT_TOKEN=replace-with-a-private-random-token-at-least-16-chars
